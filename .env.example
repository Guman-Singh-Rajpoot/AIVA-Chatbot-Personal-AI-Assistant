# Copy this file to .env and fill in your own values.

# PostgreSQL connection string. If this is not set, the server automatically
# falls back to an in-memory store so the app still runs locally, but data
# will NOT persist between restarts.
#
# Example (local Postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiva
#
# Example (Neon / Supabase / Railway, etc. — use the connection string they give you):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Port the server listens on (defaults to 5000)
PORT=5000
